# LabPilot AI 环境配置示例 — 复制为 .env 后按需修改。不要把真实密钥提交进仓库。
# 后端
DATABASE_URL=sqlite:////home/hatch/workspace/labpilot-ai/backend/data/labpilot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产 Turso 示例（部署波次使用，Wave 1 不需要）：
# DATABASE_URL=libsql://labpilot-xxx.turso.io

# AI（Wave 4 才接入；Wave 1 不需要任何 Key，规则版 fallback 即可工作）
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# GLM_API_KEY=

# 前端（写在 frontend/.env）
# VITE_API_URL=http://localhost:8000
