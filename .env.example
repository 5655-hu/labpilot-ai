# LabPilot AI 环境配置示例 — 复制为 .env 后按需修改。不要把真实密钥提交进仓库。
# 后端
# 留空即使用默认本地库 backend/data/labpilot.db；需要指定路径时打开下一行（绝对路径）。
# DATABASE_URL=sqlite:///C:/path/to/labpilot.db          # Windows
# DATABASE_URL=sqlite:////home/you/labpilot.db          # Linux/macOS（注意 4 个斜杠）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产 Turso 示例（部署波次使用，需要 libsql-experimental；Windows 上该包被跳过）：
# DATABASE_URL=libsql://labpilot-xxx.turso.io
# TURSO_AUTH_TOKEN=

# AI（没有 Key 也能跑：规则版 fallback 照常出报告）
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# GLM_API_KEY=
# Gemini 走仓库外的 custom.gemini 连接器；不在默认位置时用这个变量指过去
# GEMINI_HELPER_PATH=C:/Users/<you>/workspace/custom-connectors/custom.gemini/bin/gemini.py

# 前端（写在 frontend/.env）
# VITE_API_URL=http://localhost:8000
